# The heptix client: plays the sounds, keeps the stats, shows nothing.
# Input events come from the reader service over /run/heptix/events.sock.
[Unit]
Description=heptix - the missing haptic feedback for Linux
After=pipewire.service

[Service]
ExecStart=/usr/lib/heptix/heptix --client
Restart=on-failure
RestartSec=2
# No network: only local unix sockets (the audio server and the reader) are allowed.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
NoNewPrivileges=yes
# User units get a minimal PATH; heptix needs pw-cat, paplay or aplay.
Environment=PATH=/run/current-system/sw/bin:/etc/profiles/per-user/%u/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
