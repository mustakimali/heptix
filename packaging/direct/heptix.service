[Unit]
Description=heptix touchpad click sound
After=pipewire.service

[Service]
ExecStart=%h/.local/bin/heptix --direct @ARGS@
Restart=on-failure
RestartSec=2
# No network: only local unix sockets (the audio server) are allowed.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
NoNewPrivileges=yes
# Direct mode (not recommended): this process reads the input devices itself, so
# your user must be in the 'input' group. See the README for the reader service.
# User units get a minimal PATH; heptix needs pw-cat (or paplay/aplay).
Environment=PATH=/run/current-system/sw/bin:/etc/profiles/per-user/%u/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
