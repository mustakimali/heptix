[Unit]
Description=heptix touchpad click sound
After=pipewire.service

[Service]
ExecStart=%h/.local/bin/heptix --run @ARGS@
Restart=on-failure
RestartSec=2
# User units get a minimal PATH; heptix needs pw-cat (or paplay/aplay).
Environment=PATH=/run/current-system/sw/bin:/etc/profiles/per-user/%u/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
